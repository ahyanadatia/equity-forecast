# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Price caches. Real prices are re-downloadable; the simulated universes are
# regenerated byte-identically by scripts/make_synthetic_universe.py.
data/

# Run outputs. Two directories are committed so the README can embed them:
#   results/latest/  - the headline run's summary and figures
#   results/control/ - the positive-control run, which is the evidence that a
#                      null result in results/latest/ is about the data and not
#                      about the code
# Everything else under results/ is a per-run output directory and is ignored.
results/*
!results/latest/
!results/latest/**
!results/control/
!results/control/**
!results/null/
!results/null/**

# OS
.DS_Store
